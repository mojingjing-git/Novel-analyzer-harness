+@pytest.mark.asyncio
+async def test_analyzer_skips_reparse_when_cache_hit():
+    """On a cache hit, safe_parse_json must not run again inside _parse_response.
+
+    Spied by wrapping the module-level `safe_parse_json` that `analyzer`
