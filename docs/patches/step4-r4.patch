+@pytest.mark.parametrize(
+    "raw,expected",
+    [
+        ("\u9b54\u9053\u4e1a\u7ee3", True),
+        ("\u300a\u9b54\u9053\u4e1a\u7ee3\u300b", True),
+        ("a", False),                     # too short
+        ("", False),
+        ("   ", False),
