{
  "api": {
    "base_url": "https://api.minimaxi.com/v1",
    "api_key": "YOUR_API_KEY_HERE",
    "model": "MiniMax-M3",
    "max_tokens": 65535,
    "timeout": 200,
    "summary_timeout": 600,
    "max_retries": 5,
    "json_mode": "default",
    "temperature": 0.5,
    "temperature_step": 0.25,
    "temperature_max_retries": 2,
    "backoff_max_retries": 1,
    "thinking_mode": {},
    "summary_model": "",
    "summary_thinking_mode": {},
    "provider": "auto",
    "streaming_enabled": true
  },
  "analysis": {
    "max_arc_length": 1500,
    "concurrency": 8,
    "block_size": 4,
    "encoding_priority": [
      "utf-8",
      "gbk",
      "gb2312",
      "gb18030",
      "big5",
      "utf-16",
      "utf-8-sig",
      "latin-1",
      "cp1252",
      "shift_jis",
      "euc-kr"
    ],
    "max_arcs_in_prompt": 30,
    "max_summaries_in_prompt": 5,
    "timeline_truncate": 200,
    "max_character_states": 20,
    "max_world_items": 20,
    "max_foreshadow_entries": 5,
    "foreshadow_kept_categories": [
      "身份", "身世", "性格", "心理", "成长", "命运", "关系", "情感",
      "战略", "阴谋", "转折", "关键事件", "行动", "悬疑", "伏线", "日常",
      "奇遇", "爽点", "战斗", "危机", "对抗", "伤亡", "复仇", "敌友",
      "家族", "师徒", "制度", "势力", "世界设定", "历史背景", "文化",
      "资源", "修炼", "异能", "伦理", "存在", "时间", "社会", "政治",
      "战争", "穿越", "系统", "升级", "商战", "职场", "推理", "科幻设定",
      "奇幻设定", "医疗", "其他"
    ],
    "foreshadow_min_importance": "低",
    "foreshadow_min_confidence": "低",
    "max_foreshadow_catalog_high": 1000,
    "max_foreshadow_catalog_mid": 200,
    "batch_summary_min_words": 2000,
    "final_report_min_words": 5000,
    "volume_compress_threshold": 80000,
    "volume_compress_group": 5,
    "rolling_early_chapters": 100,
    "rolling_max_milestones": 20,
    "rolling_max_momentum": 15,
    "checkpoint_interval": 5,
    "auto_archive": true,
    "auto_summary": true,
    "summary_concurrency": 8,
    "summary_batch_size": 35,
    "foreshadow_recheck_batch_size": 80,
    "skip_moderation_blocked": true,
    "max_compressed_arcs": 50,
    "max_recent_summaries": 5,
    "max_pacing_tracker": 100,
    "max_foreshadow_network": 100,
    "max_world_building": 200,
    "max_verified_facts": 200,
    "max_long_term_arcs": 200,
    "max_thematic_elements": 100
  },
  "gui": {
    "language": "zh-CN"
  },
  "working_directory": null,
  "knowledge_file": "knowledge.json",
  "workspace_dir": "workspace"
}
