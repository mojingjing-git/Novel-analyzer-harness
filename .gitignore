# 密钥与配置（含 API Key，绝不入库）
config.json
config_profiles.json
.env

# 运行时统一目录与状态/日志兜底忽略
/runtime/
queue_state.json
usage_state*.json
*.log
*.log.*
*.bak
.bak_*
.tmp_verify/
app.lock
session.token

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# 前端
node_modules/
frontend/dist/
frontend/coverage/
frontend/.tmp_verify/
*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts

# 开发流程产物
.superpowers/
.mimocode
.zcode
.agent
.agents/
.ruff_cache/

# 一次性调试产物
settings_resp.txt
_plan_*.md
_pytest_*.txt
_trash_*/

# 调试脚本与中间产物
_dbg_*.py
tests/fixtures/_dbg_*.py
_commit*_msg.txt

# 临时测试产物（pytest 调试残留）
_tmp_test_*/
_pytest_*.stale
_pytest_*.xml
pytest-of-*/

# 一次性脚本（根目录 scripts/）
scripts/_run_*.py
scripts/_check.py

# 过程产物目录（即使工作区有残留文件也不入 git）
docs/audit/
docs/superpowers/plans/
docs/plans/
# 阶段性规划文档（过程材料不入库；已收口的 PLAN 由 git rm 移除）
docs/PLAN-*

# PyInstaller 打包产物（v0.1.0+：dist/ 里的 exe 单独走 gh release，不入库）
build/
dist/

# 临时测试与分析产物
.tmp*
_scan*
_edits_*
_apply.py
